# V: 1.0.0

///////////////////////////////////////////////////////////////////////////////////////////////// */

QWidget {
    color: #E0E0E0;
    font: 10pt "Segoe UI";
}

/* Tooltip */
QToolTip {
    color: #FFFFFF;
    background-color: #1F2937;
    border: none;
    border-left: 2px solid #3B82F6;
    padding: 8px;
    margin: 0px;
}

/* App Background */
#bgApp {    
    background-color: #111827;
    border: 1px solid #1F2937;
}

/* Left Menu */
#leftMenuBg {    
    background-color: #1F2937;
}

#topLogo {
    background-color: #1F2937;
    background-position: centered;
    background-repeat: no-repeat;
}

/* Menu Buttons */
#topMenu .QPushButton, #bottomMenu .QPushButton {    
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color: transparent;
    text-align: left;
    padding-left: 44px;
    color: #E0E0E0;
    font-weight: bold;
}

#topMenu .QPushButton:hover, #bottomMenu .QPushButton:hover {
    background-color: #374151;
    border-left: 22px solid #3B82F6;
}

#topMenu .QPushButton:pressed, #bottomMenu .QPushButton:pressed {    
    background-color: #2563EB;
    color: #FFFFFF;
}

/* Toggle Button */
#toggleButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 20px solid transparent;
    background-color: #F8F9FA;
    text-align: left;
    padding-left: 44px;
    color: #2C3E50;
}

#toggleButton:hover {
    background-color: #F0F2F5;
}

#toggleButton:pressed {
    background-color: #3498DB;
    color: #FFFFFF;
}

/* Content Area */
#contentTopBg {
    background-color: #1F2937;
    border-bottom: 1px solid #374151;
}

/* Top Buttons */
#rightButtons .QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    color: #2C3E50;
}

#rightButtons .QPushButton:hover {
    background-color: #F0F2F5;
}

#rightButtons .QPushButton:pressed {
    background-color: #E9ECEF;
}

/* Loading Animation */
QProgressBar {
    border: 2px solid #3B82F6;
    border-radius: 5px;
    text-align: center;
    color: #E0E0E0;
    background-color: #1F2937;
}

QProgressBar::chunk {
    background-color: #3B82F6;
    width: 10px;
    margin: 0.5px;
}

/* Table Widget */
QTableWidget {
    background-color: #1F2937;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #374151;
    gridline-color: #374151;
}

QTableWidget::item {
    border-color: #374151;
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #374151;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #4B5563;
    color: #E0E0E0;
    font-weight: bold;
}

/* Scroll Bars */
QScrollBar:horizontal, QScrollBar:vertical {
    border: none;
    background: #1F2937;
    height: 8px;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background: #3B82F6;
    min-width: 25px;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background: #2563EB;
}

/* Line Edit */
QLineEdit {
    background-color: #374151;
    border: 2px solid #4B5563;
    border-radius: 5px;
    padding: 8px;
    color: #E0E0E0;
}

QLineEdit:hover {
    border: 2px solid #3B82F6;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}

/* Push Buttons */
QPushButton {
    border: none;
    border-radius: 5px;
    background-color: #3B82F6;
    color: #FFFFFF;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
}

QPushButton:disabled {
    background-color: #4B5563;
    color: #9CA3AF;
}

/* Combo Box */
QComboBox {
    background-color: #374151;
    border: 2px solid #4B5563;
    border-radius: 5px;
    padding: 8px;
    color: #E0E0E0;
}

QComboBox:hover {
    border: 2px solid #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/icons/images/icons/cil-arrow-bottom.png);
    width: 12px;
    height: 12px;
}

/* Loading Overlay */
#loadingOverlay {
    background-color: rgba(31, 41, 55, 0.7);
    border-radius: 10px;
}

#loadingLabel {
    color: #E0E0E0;
    font-size: 14pt;
    font-weight: bold;
}

/* Message Boxes */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* Status Bar */
QStatusBar {
    background-color: #1F2937;
    color: #E0E0E0;
}

/* Menu Bar */
QMenuBar {
    background-color: #1F2937;
    color: #E0E0E0;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #374151;
}

/* Tool Bar */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #E9ECEF;
    margin: 4px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #374151;
    background-color: #1F2937;
}

QTabBar::tab {
    background-color: #374151;
    border: 1px solid #4B5563;
    padding: 8px 16px;
    color: #E0E0E0;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
}

QTabBar::tab:hover:not([selected]) {
    background-color: #4B5563;
}

/* Title Menu */
#titleRightInfo { padding-left: 10px; color: #00DF82; font: 12pt "Segoe UI"; } /* Increase font size here */

/* Extra Tab */
#extraLeftBox {    
    background-color: #03624c;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
#extraTopBg{    
    background-color: #00DF82;
}

/* Icon */
#extraIcon {
    background-position: center;
    background-repeat: no-repeat;
    background-image: url(:/icons/images/icons/icon_settings.png);
}

/* Label */
#extraLabel { color: #00DF82; font: 12pt "Segoe UI"; } /* Increase font size here */

/* Btn Close */
#extraCloseColumnBtn { background-color: rgba(0, 223, 130, 0.2); border: none;  border-radius: 5px; }
#extraCloseColumnBtn:hover { background-color: #00DF82; border-style: solid; border-radius: 4px; }
#extraCloseColumnBtn:pressed { background-color: #03624c; border-style: solid; border-radius: 4px; }

/* Extra Content */
#extraContent{
    border-top: 3px solid #03624c;
}

/* Extra Top Menus */
#extraTopMenu .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color:transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
#extraTopMenu .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#extraTopMenu .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}

/* Content App */
#contentBottom{
    border-top: 3px solid #00DF82;
}
#titleRightInfo{
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}

/* Theme Settings */
#extraRightBox { background-color: #03624c; }
#themeSettingsTopDetail { background-color: #00DF82; }

/* Bottom Bar */
#bottomBar { background-color: #03624c }
#bottomBar QLabel { font-size: 13pt; color: #00DF82; padding-left: 10px; padding-right: 10px; padding-bottom: 2px; } /* Increase font size here */

/* Content Settings */
/* MENUS */
#contentSettings .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color:transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
#contentSettings .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#contentSettings .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}

/* QTableWidget */
QTableWidget {    
    background-color: transparent;
    padding: 10px;
    border-radius: 5px;
    outline: none;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
QTableWidget::item{
    border-color: #03624c;
    padding-left: 5px;
    padding-right: 5px;
}
QTableWidget::item:selected{
    background-color: #00DF82;
    color: #030f0f;
}
QHeaderView::section{
    background-color: #03624c;
    max-width: 30px;
    border: none;
    border-style: none;
}
QTableWidget::horizontalHeader {    
    background-color: #03624c;
}
QHeaderView::section:horizontal {
    border: 1px solid #03624c;
    background-color: #03624c;
    padding: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
QHeaderView::section:vertical {
    border: 1px solid #03624c;
}

/* LineEdit */
QLineEdit {
    background-color: #03624c;
    border-radius: 5px;
    border: 2px solid #03624c;
    padding-left: 10px;
    selection-color: #030f0f;
    selection-background-color: #00DF82;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
QLineEdit:hover {
    border: 2px solid #00DF82;
}
QLineEdit:focus {
    border: 2px solid #00DF82;
}

/* PlainTextEdit */
QPlainTextEdit {
    background-color: #03624c;
    border-radius: 5px;
    padding: 10px;
    selection-color: #030f0f;
    selection-background-color: #00DF82;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
QPlainTextEdit QScrollBar:vertical {
    width: 8px;
}
QPlainTextEdit QScrollBar:horizontal {
    height: 8px;
}
QPlainTextEdit:hover {
    border: 2px solid #00DF82;
}
QPlainTextEdit:focus {
    border: 2px solid #00DF82;
}

/* ScrollBars */
QScrollBar:horizontal {
    border: none;
    background: #03624c;
    height: 8px;
    margin: 0px 21px 0 21px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #00DF82;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #03624c;
    width: 20px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #03624c;
    width: 20px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal {
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* CheckBox */
QCheckBox::indicator {
    border: 3px solid #03624c;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #03624c;
}
QCheckBox::indicator:hover {
    border: 3px solid #00DF82;
}
QCheckBox::indicator:checked {
    background: 3px solid #00DF82;
    border: 3px solid #00DF82;    
    background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* RadioButton */
QRadioButton::indicator {
    border: 3px solid #03624c;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #03624c;
}
QRadioButton::indicator:hover {
    border: 3px solid #00DF82;
}
QRadioButton::indicator:checked {
    background: 3px solid #00DF82;
    border: 3px solid #00DF82;    
}

/* ComboBox */
QComboBox {
    background-color: #03624c;
    border-radius: 5px;
    border: 2px solid #03624c;
    padding: 5px;
    padding-left: 10px;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
QComboBox:hover {
    border: 2px solid #00DF82;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px; 
    border-left-width: 3px;
    border-left-color: #03624c;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;    
    background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
    background-position: center;
    background-repeat: no-repeat;
}
QComboBox QAbstractItemView {
    color: #00DF82;    
    background-color: #03624c;
    padding: 10px;
    selection-background-color: #00DF82;
    selection-color: #030f0f;
}

/* Sliders */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
    margin: 0px;
    background-color: #03624c;
}
QSlider::groove:horizontal:hover {
    background-color: #00DF82;
}
QSlider::handle:horizontal {
    background-color: #00DF82;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:horizontal:hover {
    background-color: #03624c;
}
QSlider::handle:horizontal:pressed {
    background-color: #00DF82;
}

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
    background-color: #03624c;
}
QSlider::groove:vertical:hover {
    background-color: #00DF82;
}
QSlider::handle:vertical {
    background-color: #00DF82;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:vertical:hover {
    background-color: #03624c;
}
QSlider::handle:vertical:pressed {
    background-color: #00DF82;
}

/* CommandLinkButton */
#pagesContainer QCommandLinkButton {    
    color: #00DF82;
    border-radius: 5px;
    padding: 5px;
    border: 2px solid #03624c;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
#pagesContainer QCommandLinkButton:hover {    
    color: #030f0f;
    background-color: #00DF82;
}
#pagesContainer QCommandLinkButton:pressed {    
    color: #00DF82;
    background-color: #03624c;
}

/* Button */
#pagesContainer QPushButton {
    border: 2px solid #03624c;
    border-radius: 5px;    
    background-color: #03624c;
    color: #00DF82;
    font: 12pt "Segoe UI"; /* Increase font size here */
}
#pagesContainer QPushButton:hover {
    background-color: #00DF82;
    border: 2px solid #00DF82;
    color: #030f0f;
}
#pagesContainer QPushButton:pressed {    
    background-color: #03624c;
    border: 2px solid #00DF82;
    color: #00DF82;
}

/* Group Box */
QGroupBox {
    border: 2px solid #374151;
    border-radius: 5px;
    margin-top: 20px;
    font-weight: bold;
    color: #E0E0E0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: #E0E0E0;
    background-color: #1F2937;
}


