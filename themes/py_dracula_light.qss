QWidget{
    background-color: #030f0f;
    color: #00DF82;
    font: 10pt "Segoe UI";
}

/* Tooltip */
QToolTip {
    color: #030f0f;
    background-color: #00DF82;
    border: 1px solid #03624c;
    padding: 5px;
}

/* Background App */
#bgApp {    
    background-color: #030f0f;
    border: 1px solid #03624c;
    color: #00DF82;
}

/* Left Menu */
#leftMenuBg {    
    background-color: #03624c;
}
#topLogo {
    background-color: #03624c;
    background-image: url(:/images/images/images/PyDracula.png);
    background-position: centered;
    background-repeat: no-repeat;
}
#titleLeftApp { font: 63 12pt "Segoe UI Semibold"; color: #00DF82; }
#titleLeftDescription { font: 8pt "Segoe UI"; color: #00DF82; }

/* MENUS */
#topMenu .QPushButton {    
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color: transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
}
#topMenu .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#topMenu .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}
#bottomMenu .QPushButton {    
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 20px solid transparent;
    background-color:transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
}
#bottomMenu .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#bottomMenu .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}
#leftMenuFrame{
    border-top: 3px solid #00DF82;
}

/* Toggle Button */
#toggleButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 20px solid transparent;
    background-color: #03624c;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
}
#toggleButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#toggleButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}

/* Title Menu */
#titleRightInfo { padding-left: 10px; color: #00DF82; }

/* Extra Tab */
#extraLeftBox {    
    background-color: #03624c;
    color: #00DF82;
}
#extraTopBg{    
    background-color: #00DF82;
}

/* Icon */
#extraIcon {
    background-position: center;
    background-repeat: no-repeat;
    background-image: url(:/icons/images/icons/icon_settings.png);
}

/* Label */
#extraLabel { color: #00DF82; }

/* Btn Close */
#extraCloseColumnBtn { background-color: rgba(0, 223, 130, 0.2); border: none;  border-radius: 5px; }
#extraCloseColumnBtn:hover { background-color: #00DF82; border-style: solid; border-radius: 4px; }
#extraCloseColumnBtn:pressed { background-color: #03624c; border-style: solid; border-radius: 4px; }

/* Extra Content */
#extraContent{
    border-top: 3px solid #03624c;
}

/* Extra Top Menus */
#extraTopMenu .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color:transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
}
#extraTopMenu .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#extraTopMenu .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}

/* Content App */
#contentTopBg{    
    background-color: #03624c;
}
#contentBottom{
    border-top: 3px solid #00DF82;
}
#titleRightInfo{
    color: #00DF82;
}

/* Top Buttons */
#rightButtons .QPushButton { background-color: rgba(0, 223, 130, 0.2); border: none;  border-radius: 5px; }
#rightButtons .QPushButton:hover { background-color: #00DF82; border-style: solid; border-radius: 4px; }
#rightButtons .QPushButton:pressed { background-color: #03624c; border-style: solid; border-radius: 4px; }

/* Theme Settings */
#extraRightBox { background-color: #03624c; }
#themeSettingsTopDetail { background-color: #00DF82; }

/* Bottom Bar */
#bottomBar { background-color: #03624c }
#bottomBar QLabel { font-size: 11px; color: #00DF82; padding-left: 10px; padding-right: 10px; padding-bottom: 2px; }

/* Content Settings */
/* MENUS */
#contentSettings .QPushButton {
    background-position: left center;
    background-repeat: no-repeat;
    border: none;
    border-left: 22px solid transparent;
    background-color:transparent;
    text-align: left;
    padding-left: 44px;
    color: #00DF82;
}
#contentSettings .QPushButton:hover {
    background-color: #00DF82;
    color: #030f0f;
}
#contentSettings .QPushButton:pressed {    
    background-color: #03624c;
    color: #00DF82;
}

/* QTableWidget */
QTableWidget {    
    background-color: transparent;
    padding: 10px;
    border-radius: 5px;
    outline: none;
}
QTableWidget::item{
    border-color: #03624c;
    padding-left: 5px;
    padding-right: 5px;
    gridline-color: #03624c;
}
QTableWidget::item:selected{
    background-color: #00DF82;
    color: #030f0f;
}
QHeaderView::section{
    background-color: #03624c;
    max-width: 30px;
    border: none;
    border-style: none;
}
QTableWidget::horizontalHeader {    
    background-color: #03624c;
}
QHeaderView::section:horizontal {
    border: 1px solid #03624c;
    background-color: #03624c;
    padding: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #00DF82;
}
QHeaderView::section:vertical {
    border: 1px solid #03624c;
}

/* LineEdit */
QLineEdit {
    background-color: #03624c;
    border-radius: 5px;
    border: 2px solid #03624c;
    padding-left: 10px;
    selection-color: #030f0f;
    selection-background-color: #00DF82;
    color: #00DF82;
}
QLineEdit:hover {
    border: 2px solid #00DF82;
}
QLineEdit:focus {
    border: 2px solid #00DF82;
}

/* PlainTextEdit */
QPlainTextEdit {
    background-color: #03624c;
    border-radius: 5px;
    padding: 10px;
    selection-color: #030f0f;
    selection-background-color: #00DF82;
    color: #00DF82;
}
QPlainTextEdit QScrollBar:vertical {
    width: 8px;
}
QPlainTextEdit QScrollBar:horizontal {
    height: 8px;
}
QPlainTextEdit:hover {
    border: 2px solid #00DF82;
}
QPlainTextEdit:focus {
    border: 2px solid #00DF82;
}

/* ScrollBars */
QScrollBar:horizontal {
    border: none;
    background: #03624c;
    height: 8px;
    margin: 0px 21px 0 21px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #00DF82;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #03624c;
    width: 20px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #03624c;
    width: 20px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal {
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QScrollBar:vertical {
    border: none;
    background-color: #03624c;
    width: 8px;
    margin: 21px 0 21px 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {    
    background: #00DF82;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical {
    border: none;
    background: #03624c;
    height: 20px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:vertical {
    border: none;
    background: #03624c;
    height: 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* CheckBox */
QCheckBox::indicator {
    border: 3px solid #03624c;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #03624c;
}
QCheckBox::indicator:hover {
    border: 3px solid #00DF82;
}
QCheckBox::indicator:checked {
    background: 3px solid #00DF82;
    border: 3px solid #00DF82;    
    background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* RadioButton */
QRadioButton::indicator {
    border: 3px solid #03624c;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #03624c;
}
QRadioButton::indicator:hover {
    border: 3px solid #00DF82;
}
QRadioButton::indicator:checked {
    background: 3px solid #00DF82;
    border: 3px solid #00DF82;    
}

/* ComboBox */
QComboBox {
    background-color: #03624c;
    border-radius: 5px;
    border: 2px solid #03624c;
    padding: 5px;
    padding-left: 10px;
    color: #00DF82;
}
QComboBox:hover {
    border: 2px solid #00DF82;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px; 
    border-left-width: 3px;
    border-left-color: #03624c;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;    
    background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
    background-position: center;
    background-repeat: no-repeat;
}
QComboBox QAbstractItemView {
    color: #00DF82;    
    background-color: #03624c;
    padding: 10px;
    selection-background-color: #00DF82;
    selection-color: #030f0f;
}

/* Sliders */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
    margin: 0px;
    background-color: #03624c;
}
QSlider::groove:horizontal:hover {
    background-color: #00DF82;
}
QSlider::handle:horizontal {
    background-color: #00DF82;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:horizontal:hover {
    background-color: #03624c;
}
QSlider::handle:horizontal:pressed {
    background-color: #00DF82;
}

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
    background-color: #03624c;
}
QSlider::groove:vertical:hover {
    background-color: #00DF82;
}
QSlider::handle:vertical {
    background-color: #00DF82;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:vertical:hover {
    background-color: #03624c;
}
QSlider::handle:vertical:pressed {
    background-color: #00DF82;
}

/* CommandLinkButton */
#pagesContainer QCommandLinkButton {    
    color: #00DF82;
    border-radius: 5px;
    padding: 5px;
    border: 2px solid #03624c;
}
#pagesContainer QCommandLinkButton:hover {    
    color: #030f0f;
    background-color: #00DF82;
}
#pagesContainer QCommandLinkButton:pressed {    
    color: #00DF82;
    background-color: #03624c;
}

/* Button */
#pagesContainer QPushButton {
    border: 2px solid #03624c;
    border-radius: 5px;    
    background-color: #03624c;
    color: #00DF82;
}
#pagesContainer QPushButton:hover {
    background-color: #00DF82;
    border: 2px solid #00DF82;
    color: #030f0f;
}
#pagesContainer QPushButton:pressed {    
    background-color: #03624c;
    border: 2px solid #00DF82;
    color: #00DF82;
}


